<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>cards</title>
{# 디자인: docs/plans/phase3-card-design.md. 틀 문구: docs/scripts/cards-script.md 1절. 외부 요청을 하나도 두지 않는다. #}
<style>
:root{--w:1080px;--h:1350px;--pad:48px;
  --bg:#F6F5F3;--ink:#111111;--body:#6E6E73;--faint:#A1A1A6;--line:#EEEDEA;--dark:#141414;
  --us:#2F6BF6;--seoul:#A9C4FD;
  --font:-apple-system,BlinkMacSystemFont,"Segoe UI","Pretendard","Malgun Gothic","Apple SD Gothic Neo","Noto Sans CJK KR",sans-serif}
@page{size:1080px 1350px;margin:0}
*{box-sizing:border-box;margin:0;padding:0}
html,body{background:var(--bg)}
body{font-family:var(--font);color:var(--ink);word-break:keep-all;-webkit-font-smoothing:antialiased;
  -webkit-print-color-adjust:exact;print-color-adjust:exact}
.card{width:var(--w);height:var(--h);padding:var(--pad);background:var(--bg);position:relative;overflow:hidden;
  display:flex;flex-direction:column;break-after:page}
.card:last-of-type{break-after:auto}
.topbar{display:flex;justify-content:space-between;font-size:22px;font-weight:700;line-height:1;letter-spacing:.14em;text-transform:uppercase}
.topbar .project{text-decoration:underline;text-underline-offset:6px;text-decoration-thickness:2px}
.topbar .eyebrow{letter-spacing:.02em}  /* 한글 라벨은 영문 대문자용 자간(.14em)을 받으면 글자가 벌어진다 */
.main{flex:1;min-height:0;display:flex;flex-direction:column;justify-content:center}
.pill{flex:none;height:56px;border:2px solid transparent;border-radius:999px;padding:0 30px;
  background:linear-gradient(var(--bg),var(--bg)) padding-box,linear-gradient(90deg,#FBD9B5,#F4645A) border-box;
  display:flex;align-items:center;justify-content:space-between;font-size:20px;font-weight:700;line-height:1}
.pill-url{color:var(--body);letter-spacing:.02em}
.swipe{letter-spacing:.02em}
.accent{font-style:normal;background:linear-gradient(180deg,#FBBF6B 0%,#F9A14A 45%,#F4645A 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent}
.title{font-size:76px;font-weight:700;line-height:1.08;letter-spacing:-.02em}
.title.xl{font-size:104px;line-height:1.06}
.page{font-size:44px;font-weight:400;color:var(--faint);letter-spacing:0}
.subtitle{font-size:30px;font-weight:700;color:var(--faint);margin-top:28px}
.lead{font-size:34px;font-weight:400;line-height:1.45;color:var(--body);margin-top:24px}
.items{list-style:none;margin-top:44px}
.item{display:flex;gap:18px}
.item+.item{margin-top:22px}
.mark{font-size:22px;line-height:46px;color:var(--faint)}
.strong{font-size:32px;font-weight:700;line-height:1.45}
.rest{font-size:32px;font-weight:400;line-height:1.45;color:var(--body)}
.panel{background:#FFFFFF;border-radius:28px;padding:36px 40px 40px;margin-top:40px}
.legend{display:flex;gap:32px;font-size:24px;font-weight:700;color:var(--body);margin-bottom:28px}
.dot{display:inline-block;width:14px;height:14px;border-radius:999px;margin-right:10px;vertical-align:middle}
.dot.us,.bar.us{background:var(--us)}
.dot.seoul,.bar.seoul{background:var(--seoul)}
.bars{display:flex;align-items:flex-end;gap:24px;height:300px;border-bottom:2px solid var(--line)}
.group{flex:1;display:flex;justify-content:center;align-items:flex-end;gap:12px;height:100%}
.bar{width:30px;border-radius:999px 999px 0 0}
.labels{display:flex;gap:24px;margin-top:18px}
.label{flex:1;text-align:center}
.pname{font-size:22px;font-weight:700;color:var(--faint);letter-spacing:.04em;text-transform:uppercase}
.val{font-size:26px;font-weight:700;margin-top:6px;white-space:nowrap}
.note{font-size:26px;font-weight:400;line-height:1.45;color:var(--faint)}
.panel+.note{margin-top:28px}
.banners{margin-top:40px}
.banner{background:var(--dark);color:#FFFFFF;border-radius:36px;padding:36px 44px;text-align:center}
.banner+.banner{margin-top:24px}
.banner-label{font-size:24px;font-weight:700;color:rgba(255,255,255,.62)}
.banner-key{font-size:22px;font-weight:700;color:rgba(255,255,255,.45);letter-spacing:.04em;margin-top:22px}
.order{font-size:34px;font-weight:700;line-height:1.3;margin-top:6px}
.order.before{color:rgba(255,255,255,.62)}
.closing-url{font-size:36px;font-weight:700;margin-top:48px;letter-spacing:.01em}
</style>
</head>
<body>
{% for n, card in pages %}
<section class="card" data-kind="{{ card.kind }}">
  <div class="topbar"><span class="project">CONSUMPTION INSIGHTS</span><span class="eyebrow">{{ eyebrow }}</span></div>
  <div class="main"><div class="content">
{% if card.kind == "cover" %}
    <h1 class="title xl" data-role="title" data-lines="2" data-orphan="skip">{{ card.title[0].text }}<br><em class="accent">{{ card.title[1].text }}</em></h1>
    <p class="subtitle" data-role="subtitle" data-lines="1">{{ card.subtitle }}</p>
    <p class="lead" data-role="lead" data-lines="3">{{ card.lead }}</p>
{% else %}
    <h2 class="title{% if card.kind == 'closing' %} xl{% endif %}" data-role="title" data-lines="2">{% for part in card.title %}{% if part.accent %}<em class="accent">{{ part.text }}</em>{% else %}{{ part.text }}{% endif %}{% endfor %}{% if card.page %} <span class="page">{{ card.page }}</span>{% endif %}</h2>
    <p class="lead" data-role="lead" data-lines="3">{{ card.lead }}</p>
{% endif %}
{% if card.kind == "bullets" %}
    <ul class="items">
{% for item in card["items"] %}
      <li class="item"><span class="mark">&#9642;</span><div><p class="strong" data-role="item" data-lines="1">{{ item.strong }}</p><p class="rest" data-role="item" data-lines="1">{{ item.rest }}</p></div></li>
{% endfor %}
    </ul>
{% elif card.kind == "chart" %}
{% set top = [card.series.us.values()|max, card.series.seoul.values()|max]|max %}
    <div class="panel">
      <div class="legend"><span><i class="dot us"></i>미국 리전</span><span><i class="dot seoul"></i>서울 리전</span></div>
      <div class="bars">
{% for platform, amount in card.series.us.items() %}
        <div class="group"><div class="bar us" style="height:{{ '%.1f'|format(amount / top * 100) }}%"></div><div class="bar seoul" style="height:{{ '%.1f'|format(card.series.seoul[platform] / top * 100) }}%"></div></div>
{% endfor %}
      </div>
      <div class="labels">
{% for platform, amount in card.series.us.items() %}
        <div class="label"><p class="pname" data-role="platform" data-lines="1">{{ platform|platform }}</p><p class="val" data-role="amount" data-lines="1"><i class="dot us"></i>{{ amount|usd }}</p><p class="val" data-role="amount" data-lines="1"><i class="dot seoul"></i>{{ card.series.seoul[platform]|usd }}</p></div>
{% endfor %}
      </div>
    </div>
{% for note in card.notes %}
    <p class="note" data-role="note" data-lines="1">{{ note }}</p>
{% endfor %}
{% elif card.kind == "banners" %}
    <div class="banners">
{% for banner in card.banners %}
      <div class="banner">
        <p class="banner-label" data-role="banner-label" data-lines="1">{{ banner.label }}</p>
        <p class="banner-key">이전</p>
        <p class="order before" data-role="order" data-lines="2">{{ banner.before|order }}</p>
        <p class="banner-key">현재</p>
        <p class="order after" data-role="order" data-lines="2">{{ banner.after|order }}</p>
      </div>
{% endfor %}
    </div>
{% elif card.kind == "closing" %}
    <p class="closing-url" data-role="url" data-lines="1">{{ card.url }}</p>
{% endif %}
  </div></div>
  <div class="pill"><span class="pill-url">{{ dashboard }}</span><span class="swipe">{% if n == total %}끝{% else %}넘기기 &nbsp;/&nbsp; &#8594;{% endif %}</span></div>
</section>
{% endfor %}
{% if measure %}
<script>
/* 레이아웃 측정(굽기 전 검사용). 공개용 cards.html에는 들어가지 않는다. 결과는 ASCII JSON이다. */
(function () {
  var report = [];
  document.querySelectorAll('.card').forEach(function (card, i) {
    var box = card.getBoundingClientRect();
    var pad = parseFloat(getComputedStyle(card).paddingLeft);
    var content = card.querySelector('.content').getBoundingClientRect();
    var top = card.querySelector('.topbar').getBoundingClientRect();
    var pill = card.querySelector('.pill').getBoundingClientRect();
    var fields = [];
    card.querySelectorAll('[data-lines]').forEach(function (el) {
      var size = parseFloat(getComputedStyle(el).fontSize);
      var range = document.createRange();
      range.selectNodeContents(el);
      var lines = [];
      Array.prototype.forEach.call(range.getClientRects(), function (r) {
        if (r.width <= 0 || r.height <= 0) return;
        var mid = (r.top + r.bottom) / 2;
        var line = lines.filter(function (l) { return Math.abs(l.mid - mid) < size * 0.5; })[0];
        if (line) { line.left = Math.min(line.left, r.left); line.right = Math.max(line.right, r.right); }
        else lines.push({mid: mid, left: r.left, right: r.right});
      });
      lines.sort(function (a, b) { return a.mid - b.mid; });
      var last = lines[lines.length - 1];
      fields.push({role: el.dataset.role, max: Number(el.dataset.lines), lines: lines.length,
        right: Math.round(Math.max.apply(null, lines.map(function (l) { return l.right; })) - box.left),
        last_em: last ? Math.round((last.right - last.left) / size * 100) / 100 : 0,
        orphan_check: el.dataset.orphan !== 'skip'});
    });
    report.push({card: i + 1, gap_top: Math.round(content.top - top.bottom), gap_bottom: Math.round(pill.top - content.bottom),
      limit_right: Math.round(box.width - pad), fields: fields});
  });
  var pre = document.createElement('pre');
  pre.id = 'layout-report';
  pre.textContent = JSON.stringify(report);
  document.body.appendChild(pre);
})();
</script>
{% endif %}
</body>
</html>
